# Copy this file to ".env" for localhost (netlify dev reads it). On Netlify, add the same names under
# Site configuration > Environment variables.  NEVER commit .env to GitHub.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# From the S.I.M app: LICENSES > CONNECT TO MY WEBSITE > COPY SIGNING KEY  (64 hex characters)
LICENCE_SIGNING_KEY=

# Razorpay keys are NOT here: enter them in the website under Admin > Settings (stored server-side only).

# Optional: the Groq key for the shared AI brain (or paste it in Admin > Settings > Shared AI brain instead)
GROQ_API_KEY=
